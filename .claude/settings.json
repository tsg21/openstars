{
  "permissions": {
    "allow": [
      "WebFetch(domain:starsautohost.org)",
      "Bash(scripts/rag-query *)",
      "Bash(bash backend/int_tests/run.sh)",
      "Bash(terraform plan *)",
      "Bash(gsutil ls *)",
      "Bash(gh run *)",
      "Bash(grep *)",
      "Bash(npm install *)",
      "Bash(scripts/rag-index)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(/Users/tim/code/openstars/backend/int_tests/run_docker.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command'); if echo \"$cmd\" | grep -qE '\\b(python3?|pytest)\\b' && ! echo \"$cmd\" | grep -qE '\\buv\\s+run\\b'; then echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"additionalContext\": \"Reminder: use uv run pytest / uv run python, not bare pytest/python (AGENTS.md gotcha).\"}}'; fi"
          }
        ]
      }
    ]
  }
}
