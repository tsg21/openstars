# Backend API base URL (empty = same-origin; set when running frontend standalone)
VITE_API_URL=

# Firebase / Firestore configuration
VITE_FIREBASE_PROJECT_ID=openstars-local
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=openstars-local.firebaseapp.com

# Set to "true" to connect Firebase SDK to local emulators (localhost:8085 / :9099)
VITE_FIREBASE_USE_EMULATORS=true
